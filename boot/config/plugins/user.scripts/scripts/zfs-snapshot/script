#!/bin/bash
#
# ZFS snapshots with grandfather-father-son thinning.
#
# This is the protection layer *underneath* Nextcloud. Nextcloud's own file
# versioning is user-visible and useful, but it lives inside Nextcloud: a bug,
# a compromised account, a sync client that deletes everything, or ransomware
# reaching the data directory can destroy the files AND their versions. ZFS
# snapshots are read-only at the filesystem level and none of those can touch
# them.
#
# Targets are named explicitly. Do NOT snapshot -r from `data`: Docker's zfs
# storage driver creates one dataset per image layer (46 of them at time of
# writing, under data/system), and a recursive snapshot would sweep in every
# container layer on every run.
#
# Consistency note: a ZFS snapshot is atomic, so Postgres sees it as a clean
# power-loss and replays its WAL on restore. That is recoverable, but a logical
# dump is better for a database - the backup job takes pg_dump separately.
#
# Schedule: 0 * * * *  (hourly; only fires while the server is awake, which is
# fine - data only changes while it is awake)

set -uo pipefail

DATASETS=(
  "data/nextcloud"     # user files
  "data/appdata"       # Nextcloud config, Postgres, Redis
)

PREFIX="autosnap"

# Retention. Thinning is age-based rather than count-based on purpose: this
# server powers off when idle (D10), so runs are missed unpredictably and a
# "keep the last N" scheme would silently collapse its own history.
KEEP_ALL_SECONDS=$((  48 * 3600 ))        # keep every snapshot for 48h
DAILY_SECONDS=$((  14 * 86400 ))          # then one per day for 14 days
WEEKLY_SECONDS=$((  8 * 7 * 86400 ))      # then one per week for 8 weeks
MONTHLY_SECONDS=$(( 365 * 86400 ))        # then one per month for a year

[[ -r /boot/config/scripts/lib/notify.sh ]] && . /boot/config/scripts/lib/notify.sh

log() { echo "$(date '+%F %T') $*"; }
fail() {
  log "ERROR: $*"
  declare -F notify_alert >/dev/null && notify_alert "ZFS snapshot failed" "$*"
  exit 1
}

command -v zfs >/dev/null || fail "zfs not found"

STAMP="$(date '+%Y%m%d-%H%M%S')"
now="$(date +%s)"

for ds in "${DATASETS[@]}"; do
  zfs list -H "$ds" >/dev/null 2>&1 || fail "dataset does not exist: $ds"

  # ---------------------------------------------------------------- snapshot
  snap="${ds}@${PREFIX}-${STAMP}"
  if zfs snapshot "$snap" 2>/dev/null; then
    log "created ${snap}"
  else
    fail "could not create ${snap}"
  fi

  # ------------------------------------------------------------------ thin
  # Walk newest-first and keep the first snapshot seen in each time bucket.
  declare -A seen_day=() seen_week=() seen_month=()
  kept=0; destroyed=0

  while read -r name created; do
    [[ -z "$name" ]] && continue
    age=$(( now - created ))
    keep=0

    if   (( age <= KEEP_ALL_SECONDS )); then
      keep=1
    elif (( age <= DAILY_SECONDS )); then
      k="$(date -d "@${created}" '+%Y%m%d')"
      [[ -z "${seen_day[$k]:-}" ]] && { seen_day[$k]=1; keep=1; }
    elif (( age <= WEEKLY_SECONDS )); then
      k="$(date -d "@${created}" '+%G-%V')"
      [[ -z "${seen_week[$k]:-}" ]] && { seen_week[$k]=1; keep=1; }
    elif (( age <= MONTHLY_SECONDS )); then
      k="$(date -d "@${created}" '+%Y%m')"
      [[ -z "${seen_month[$k]:-}" ]] && { seen_month[$k]=1; keep=1; }
    fi

    if (( keep )); then
      kept=$(( kept + 1 ))
    else
      if zfs destroy "$name" 2>/dev/null; then
        destroyed=$(( destroyed + 1 ))
      else
        log "WARN: could not destroy ${name} (held, or has dependent clones)"
      fi
    fi
  done < <(zfs list -H -p -t snapshot -o name,creation -S creation "$ds" 2>/dev/null \
             | grep -F "@${PREFIX}-")

  used="$(zfs get -H -o value usedbysnapshots "$ds" 2>/dev/null)"
  log "${ds}: kept ${kept}, destroyed ${destroyed}, snapshots using ${used}"
  unset seen_day seen_week seen_month
done

log "done"
