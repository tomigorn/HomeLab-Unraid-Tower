#!/bin/bash
#
# btrfs snapshots with grandfather-father-son thinning.
#
# This is the protection layer *underneath* Nextcloud. Nextcloud's own file
# versioning is user-visible and useful, but it lives inside Nextcloud: a bug,
# a compromised account, a sync client that deletes everything, or ransomware
# reaching the data directory can destroy the files AND their versions. A
# read-only btrfs snapshot is immutable at the filesystem level and none of
# those can touch it.
#
# Each share on the pool is its own subvolume (/mnt/data/<name>); snapshots
# live under /mnt/data/.snapshots/<name>/<prefix>-<stamp>. The dot-directory
# keeps Unraid from listing it as a share.
#
# Consistency note: a btrfs snapshot is atomic, so Postgres sees it as a clean
# power-loss and replays its WAL on restore. That is recoverable, but a logical
# dump is better for a database - the backup job takes pg_dump separately.
#
# Schedule: 0 * * * *  (hourly; only fires while the server is awake, which is
# fine - data only changes while it is awake)

set -uo pipefail

POOL="/mnt/data"
SNAPROOT="${POOL}/.snapshots"
SUBVOLS=(
  "nextcloud"     # user files
  "appdata"       # Nextcloud config, Postgres, Redis
)

PREFIX="autosnap"

# Retention. Thinning is age-based rather than count-based on purpose: this
# server powers off when idle (D10), so runs are missed unpredictably and a
# "keep the last N" scheme would silently collapse its own history.
KEEP_ALL_SECONDS=$((  48 * 3600 ))        # keep every snapshot for 48h
DAILY_SECONDS=$((  14 * 86400 ))          # then one per day for 14 days
WEEKLY_SECONDS=$((  8 * 7 * 86400 ))      # then one per week for 8 weeks
MONTHLY_SECONDS=$(( 365 * 86400 ))        # then one per month for a year

[[ -r /boot/config/scripts/lib/notify.sh ]] && . /boot/config/scripts/lib/notify.sh

log() { echo "$(date '+%F %T') $*"; }
fail() {
  log "ERROR: $*"
  declare -F notify_alert >/dev/null && notify_alert "btrfs snapshot failed" "$*"
  exit 1
}

command -v btrfs >/dev/null || fail "btrfs not found"
mountpoint -q "$POOL" || fail "${POOL} is not mounted"

STAMP="$(date '+%Y%m%d-%H%M%S')"
now="$(date +%s)"

for sv in "${SUBVOLS[@]}"; do
  src="${POOL}/${sv}"
  btrfs subvolume show "$src" >/dev/null 2>&1 || fail "not a subvolume: ${src}"
  mkdir -p "${SNAPROOT}/${sv}"

  # ---------------------------------------------------------------- snapshot
  snap="${SNAPROOT}/${sv}/${PREFIX}-${STAMP}"
  if btrfs subvolume snapshot -r "$src" "$snap" >/dev/null 2>&1; then
    log "created ${snap}"
  else
    fail "could not create ${snap}"
  fi

  # ------------------------------------------------------------------ thin
  # Walk newest-first and keep the first snapshot seen in each time bucket.
  # The creation time is taken from the name, which this script wrote.
  declare -A seen_day=() seen_week=() seen_month=()
  kept=0; destroyed=0
  names=()
  for d in "${SNAPROOT}/${sv}/${PREFIX}"-20[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]; do
    [[ -d "$d" ]] && names+=("$d")
  done

  for (( i=${#names[@]}-1; i>=0; i-- )); do
    name="${names[i]}"
    stamp="${name##*/${PREFIX}-}"
    created="$(date -d "${stamp:0:8} ${stamp:9:2}:${stamp:11:2}:${stamp:13:2}" +%s 2>/dev/null)" || continue
    age=$(( now - created ))
    keep=0

    if   (( age <= KEEP_ALL_SECONDS )); then
      keep=1
    elif (( age <= DAILY_SECONDS )); then
      k="$(date -d "@${created}" '+%Y%m%d')"
      [[ -z "${seen_day[$k]:-}" ]] && { seen_day[$k]=1; keep=1; }
    elif (( age <= WEEKLY_SECONDS )); then
      k="$(date -d "@${created}" '+%G-%V')"
      [[ -z "${seen_week[$k]:-}" ]] && { seen_week[$k]=1; keep=1; }
    elif (( age <= MONTHLY_SECONDS )); then
      k="$(date -d "@${created}" '+%Y%m')"
      [[ -z "${seen_month[$k]:-}" ]] && { seen_month[$k]=1; keep=1; }
    fi

    if (( keep )); then
      kept=$(( kept + 1 ))
    else
      if btrfs subvolume delete "$name" >/dev/null 2>&1; then
        destroyed=$(( destroyed + 1 ))
      else
        log "WARN: could not delete ${name}"
      fi
    fi
  done

  log "${sv}: kept ${kept}, deleted ${destroyed}"
  unset seen_day seen_week seen_month
done

log "done"
