#!/bin/bash
#
# Nightly local backup: btrfs mirror -> 6TB array disk (backup tier 2 of 3, D6).
#
# A mirror is not a backup and neither are snapshots: both live in the same
# pool, in the same machine. This tier survives losing the entire pool.
#
# Design notes:
#
# * rsync reads from a dedicated btrfs snapshot, not the live filesystem, so
#   the source cannot change mid-copy. The snapshot is deleted afterwards.
#
# * The database is dumped with pg_dump rather than copied as files. A file
#   copy of a running Postgres is only crash-consistent; a logical dump is
#   consistent by construction and can be restored into a different Postgres
#   version. The raw data directory is therefore excluded from the rsync.
#
# * Dated directories with --link-dest give multiple restore points for almost
#   no space: unchanged files are hardlinked to the previous run rather than
#   copied. This is the equivalent of the "full + incrementals" scheme, except
#   every dated directory is a complete browsable tree, so there is no chain to
#   break - losing one does not invalidate the others.
#
# * SMR-safe rsync: no --inplace (it rewrites file interiors, which is random
#   writing and the worst case for a shingled drive), --whole-file to skip
#   delta read-modify-write, and a single stream so writes stay sequential.
#
# Schedule: */30 * * * *  (fires often, no-ops unless today's backup is missing)

set -uo pipefail

POOL="/mnt/data"
SRC_SUBVOLS=("nextcloud" "appdata")
DEST_ROOT="/mnt/disk1/backup"
DB_CONTAINER="nextcloud-db"
SECRETS="/boot/config/secrets/nextcloud.env"

# Retention of dated backup trees on the 6TB.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=6

# Excluded from the file copy: Postgres is handled by pg_dump, and Redis holds
# only a rebuildable cache.
EXCLUDES=(--exclude "nextcloud-db/" --exclude "nextcloud-redis/")

RSYNC_OPTS=(-a --delete --whole-file --numeric-ids --human-readable)

[[ -r /boot/config/scripts/lib/notify.sh ]] && . /boot/config/scripts/lib/notify.sh

TODAY="$(date '+%Y-%m-%d')"
STAMP="$(date '+%Y%m%d-%H%M%S')"
start_all=$SECONDS
errors=0

log()  { echo "$(date '+%F %T') $*"; }
warn() { echo "$(date '+%F %T') WARN: $*" >&2; errors=$(( errors + 1 )); }
die()  {
  echo "$(date '+%F %T') FATAL: $*" >&2
  declare -F notify_alert >/dev/null && notify_alert "Local backup FAILED" "$*"
  exit 1
}

[[ -d "$DEST_ROOT" ]] || die "destination missing: ${DEST_ROOT} (is the array started?)"

# ------------------------------------------------------- run-once-per-day guard
# This runs every 30 minutes rather than at a fixed nightly hour, because the
# server powers itself off when idle (D10) and would simply be off at 03:30.
# A fixed-time schedule on an intermittently-awake machine silently never fires
# - the worst kind of backup failure, because nothing reports an error.
#
# Instead: fire often, and no-op unless today's backup is still missing. The
# first time the server is awake each day, the backup happens.
if [[ "${FORCE:-0}" != "1" ]] \
   && [[ -d "${DEST_ROOT}/nextcloud/${TODAY}" ]] \
   && [[ -f "${DEST_ROOT}/db/nextcloud-${TODAY}.sql.gz" ]]; then
  echo "$(date '+%F %T') backup for ${TODAY} already complete - nothing to do"
  exit 0
fi

# The array disk must really be mounted. Writing into an unmounted mountpoint
# would silently fill the root filesystem instead of backing anything up.
mountpoint -q /mnt/disk1 || die "/mnt/disk1 is not a mountpoint - array not started?"

# --------------------------------------------------------------- database dump
dump_database() {
  local out="${DEST_ROOT}/db"
  mkdir -p "$out"

  if ! docker ps --format '{{.Names}}' | grep -qx "$DB_CONTAINER"; then
    warn "${DB_CONTAINER} not running - skipping database dump"
    return
  fi

  [[ -r "$SECRETS" ]] || { warn "no ${SECRETS} - skipping database dump"; return; }
  set -a; . "$SECRETS"; set +a

  # ---- roles/globals ----------------------------------------------------
  # pg_dump dumps a DATABASE, not the cluster's ROLES. Nextcloud's installer
  # creates its own role (oc_admin) and makes it own all 131 tables, and
  # Nextcloud connects as that role - not as POSTGRES_USER.
  #
  # Without this, a disaster restore produces a database whose data is
  # perfectly intact and which Nextcloud cannot log into, because the role it
  # authenticates as does not exist. Found by an actual restore drill; the
  # database dump alone restored 131 tables and threw 235 "role oc_admin does
  # not exist" errors, leaving every table owned by the wrong user.
  #
  # Restore order matters: globals FIRST, then the database dump.
  local g="${out}/globals-${TODAY}.sql.gz"
  log "dumping roles/globals -> $(basename "$g")"
  if docker exec "$DB_CONTAINER" pg_dumpall -U "$POSTGRES_USER" --globals-only 2>/dev/null \
       | gzip -c > "${g}.tmp"; then
    mv -f "${g}.tmp" "$g"
    log "  globals dump ok ($(du -h "$g" | cut -f1))"
  else
    rm -f "${g}.tmp"
    warn "pg_dumpall --globals-only failed - a restore would not recreate the oc_admin role"
  fi

  # ---- the database itself ----------------------------------------------
  local f="${out}/nextcloud-${TODAY}.sql.gz"
  log "dumping database -> $(basename "$f")"
  if docker exec "$DB_CONTAINER" pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" 2>/dev/null \
       | gzip -c > "${f}.tmp"; then
    mv -f "${f}.tmp" "$f"
    log "  database dump ok ($(du -h "$f" | cut -f1))"
  else
    rm -f "${f}.tmp"
    warn "pg_dump failed"
    return
  fi

  # Keep the same number of dumps as daily trees.
  # shellcheck disable=SC2012  # names are date-stamped and written by this script
  for pat in "nextcloud-" "globals-"; do
    ls -1t "${out}/${pat}"*.sql.gz 2>/dev/null | tail -n +$(( KEEP_DAILY + 1 )) \
      | while read -r old; do rm -f "$old" && log "  pruned old dump: $(basename "$old")"; done
  done
}

# ---------------------------------------------------------- subvolume -> array
backup_subvol() {
  local name="$1"
  local mnt="${POOL}/${name}"
  btrfs subvolume show "$mnt" >/dev/null 2>&1 || { warn "not a subvolume: ${mnt}"; return; }

  mkdir -p "${POOL}/.snapshots/${name}"
  local snap="${POOL}/.snapshots/${name}/backup-${STAMP}"
  if ! btrfs subvolume snapshot -r "$mnt" "$snap" >/dev/null 2>&1; then
    warn "could not snapshot ${mnt}"
    return
  fi

  local src="$snap"
  local dest_base="${DEST_ROOT}/${name}"
  local dest="${dest_base}/${TODAY}"
  # Newest previous dated tree, to hardlink against. Uses a sorted glob rather
  # than `ls | grep`: this value decides what --link-dest points at, and a
  # mis-parse would silently turn every nightly run into a full copy.
  local prev="" d
  for d in "${dest_base}"/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]; do
    [[ -d "$d" ]] || continue
    [[ "${d##*/}" == "$TODAY" ]] && continue
    prev="$d"   # glob expands in sorted order, so the last match is the newest
  done

  mkdir -p "$dest_base"

  local link=()
  [[ -n "$prev" ]] && link=(--link-dest="$prev") && log "  hardlinking unchanged files against $(basename "$prev")"

  log "${mnt} -> ${dest}"
  local t0=$SECONDS
  if rsync "${RSYNC_OPTS[@]}" "${EXCLUDES[@]}" "${link[@]}" "${src}/" "${dest}/"; then
    log "  ok in $(( SECONDS - t0 ))s, $(du -sh "$dest" 2>/dev/null | cut -f1) apparent"
  else
    warn "rsync failed for ${mnt}"
  fi

  btrfs subvolume delete "$snap" >/dev/null 2>&1 || warn "could not delete ${snap}"
  thin_dated "$dest_base"
}

# ------------------------------------------------- thin dated backup directories
# Same grandfather-father-son idea as the btrfs snapshots, applied to directory
# names. Age-based rather than count-based because the server powers off when
# idle, so nightly runs are missed unpredictably.
thin_dated() {
  local base="$1" now; now="$(date +%s)"
  declare -A seen_week=() seen_month=()
  local kept=0 removed=0

  # Collect via a sorted glob rather than parsing `ls`. This loop calls `rm -rf`,
  # so it must never operate on a mis-parsed path.
  local dirs=() d
  for d in "${base}"/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]; do
    [[ -d "$d" ]] && dirs+=("$d")
  done

  # Walk newest-first so the newest entry in each bucket is the one kept.
  # The glob expands ascending, so iterate in reverse.
  local i day ts age keep k
  for (( i=${#dirs[@]}-1; i>=0; i-- )); do
    d="${dirs[i]}"
    day="${d##*/}"
    ts="$(date -d "$day" +%s 2>/dev/null)" || continue
    age=$(( (now - ts) / 86400 ))
    keep=0

    if   (( age <= KEEP_DAILY )); then keep=1
    elif (( age <= KEEP_WEEKLY * 7 )); then
      k="$(date -d "$day" '+%G-%V')"
      [[ -z "${seen_week[$k]:-}" ]] && { seen_week[$k]=1; keep=1; }
    elif (( age <= KEEP_MONTHLY * 31 )); then
      k="$(date -d "$day" '+%Y%m')"
      [[ -z "${seen_month[$k]:-}" ]] && { seen_month[$k]=1; keep=1; }
    fi

    if (( keep )); then kept=$(( kept + 1 ))
    else rm -rf "$d" && removed=$(( removed + 1 )); fi
  done

  log "  retention: kept ${kept}, removed ${removed}"
}

# ----------------------------------------------------------------------- run
log "=== local backup start ==="
dump_database
for sv in "${SRC_SUBVOLS[@]}"; do backup_subvol "$sv"; done

elapsed=$(( SECONDS - start_all ))
free="$(df -h /mnt/disk1 | awk 'NR==2{print $4}')"

if (( errors > 0 )); then
  log "=== finished with ${errors} warning(s) in ${elapsed}s, ${free} free ==="
  declare -F notify_warn >/dev/null && \
    notify_warn "Local backup completed with ${errors} warning(s)" "see the User Scripts log; ${free} free on the array"
  exit 1
fi

log "=== ok in ${elapsed}s, ${free} free on the array ==="
