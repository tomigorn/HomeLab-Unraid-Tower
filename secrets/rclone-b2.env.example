# Backblaze B2 credentials for the offsite backup (backup tier 3 of 3).
#
# Copy to /boot/config/secrets/rclone-b2.env on the server and fill in.
# Never commit the filled-in version.
#
# Create an APPLICATION KEY scoped to a single bucket — not the master key.
# A scoped key that leaks can be revoked without touching the rest of the account.

B2_ACCOUNT_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET=""

# Encryption passphrase for the rclone crypt remote.
#
# ⚠️ Losing this means the offsite backup is permanently unreadable. It protects
# nothing if stored only on the NAS — keep it in your password manager as well.
RCLONE_CRYPT_PASSWORD=""
RCLONE_CRYPT_SALT=""
