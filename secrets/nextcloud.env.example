# Nextcloud + PostgreSQL credentials.
#
# The real file lives at /boot/config/secrets/nextcloud.env on the server and is
# never committed. It was generated there with `openssl rand`, so the values have
# never been in a terminal log or in this repo.
#
# To read the real values when you need them (e.g. to log in the first time):
#     ssh tower 'cat /boot/config/secrets/nextcloud.env'
#
# ⚠️ Put the admin password in your password manager. If the flash dies and you
# have not recorded it anywhere else, you lose the Nextcloud admin account.

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=""

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=""

# Set once the public URL is decided (see docs/04-security.md - only the
# container is ever exposed, never the Unraid host).
NEXTCLOUD_TRUSTED_DOMAINS=""

# Authentik OIDC client for the "nextcloud" application (Docker/Authentik/
# blueprints/nextcloud-oidc.yaml on fastpi generates them; read back with the
# ak shell). Used by configure.sh; the secret never goes on a command line.
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
