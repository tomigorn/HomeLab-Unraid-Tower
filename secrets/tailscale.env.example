# Tailscale auth key — the only sanctioned remote admin path (decision D8).
#
# Copy to /boot/config/secrets/tailscale.env on the server and fill in.
#
# Prefer a reusable, pre-authorized, tagged key with an expiry you actually track.
# An ephemeral key means the node disappears from the tailnet on restart, which
# is precisely when you need to reach a headless server.

TS_AUTHKEY=""
TS_HOSTNAME="tower"
