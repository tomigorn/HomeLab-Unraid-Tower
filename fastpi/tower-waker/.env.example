# Tower-Waker - a second instance of the Beefy-Waker service, targeting tower.
#
# Deploy to: /home/pi/Projects/Docker/Tower-Waker/.env
#
# Variable names below are GENERIC (TARGET_*) rather than BEEFY_*. See the
# handoff notes: running two instances cleanly means generalising the app's
# variable names once, rather than forking the code.

COMPOSE_PROJECT_NAME=tower-waker

# 9001 is already taken by Beefy-Waker.
WAKER_LISTEN_PORT=9002
WAKER_BIND=192.168.1.2

TARGET_NAME=tower
TARGET_MAC=60:be:b4:17:0d:e0
TARGET_BROADCAST=192.168.1.255
TARGET_PROBE_HOST=192.168.1.101

# 8080 (Nextcloud), NOT 22.
# On Unraid, SSH answers ~21s before the array is mounted, so a port-22 probe
# reports ready while /mnt is still empty. Nextcloud cannot answer until Docker
# started, which cannot happen until the array mounted.
TARGET_PROBE_PORT=8080

# Measured cold boot to a fully mounted array is 102s. Beefy's 60 would run out
# while tower is still booting.
WAKE_COUNTDOWN=120

# Unraid runs everything as root; there is no other account.
TARGET_SSH_USER=root
TARGET_HISTORY_SINCE=0
