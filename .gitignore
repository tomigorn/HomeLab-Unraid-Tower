# ---- secrets: never commit real values ----
secrets/*
!secrets/*.example
!secrets/README.md

# rclone / restic / duplicacy configs contain credentials
**/rclone.conf
**/*.key
!**/*.pub

# ---- Unraid artifacts that must not be version-controlled ----
# Licence key is bound to the flash GUID and is not ours to distribute
*.key
Trial.key

# Private SSH keys (public keys are fine and are committed).
# Paths live under boot/ since the repo mirrors the server's flash.
boot/config/ssh/**/id_*
boot/config/ssh/**/ssh_host_*
!boot/config/ssh/**/*.pub
!boot/config/ssh/root/authorized_keys

# Anything else on the flash that is machine-generated or secret
boot/config/secrets/
boot/logs/

# super.dat is a binary blob of array assignments; documented in docs/ instead
super.dat

# ---- local noise ----
*.swp
*.tmp
.DS_Store
